DATABASE_URL="postgresql://user:password@localhost:5432/nexgensocial"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
CLIENT_URL="http://localhost:5173"
SPORTSDB_API_KEY="3"

# Live-stream SFU (see README "Live streams: a dedicated SFU engine" and
# FLY_DEPLOY.md for the full explanation). Single-port mode: every WebRTC
# transport shares one UDP+TCP port pair, which is what makes this
# deployable on hosts like Fly.io that won't remap UDP ports.
# MEDIASOUP_ANNOUNCED_IP MUST be a real public IP reachable over UDP for
# anything beyond localhost testing to work -- on Fly.io this is your
# dedicated IPv4 (`fly ips allocate-v4`), NOT the default shared one.
MEDIASOUP_ANNOUNCED_IP="127.0.0.1"
MEDIASOUP_LISTEN_IP="0.0.0.0"
MEDIASOUP_WEBRTC_PORT=44444
MEDIASOUP_WORKER_COUNT=1

# Stripe payment link for advertisers. Ads are created in PENDING_PAYMENT
# and only serve once marked paid -- see README "Advertising payments" for
# why a payment link alone is not verification.
STRIPE_PAYMENT_LINK="https://buy.stripe.com/eVq00jgRAbXLcHhbbA1oI0o"

# Stripe. Set STRIPE_SECRET_KEY as a SECRET (never in fly.toml -- that file
# is committed to git). Once set, ads are activated only by the verified
# webhook; the manual confirm endpoint is disabled automatically.
STRIPE_SECRET_KEY="sk_test_..."
# From the Stripe dashboard AFTER creating a webhook pointing at
# https://<your-api>/api/premium/stripe-webhook
STRIPE_WEBHOOK_SECRET="whsec_..."
