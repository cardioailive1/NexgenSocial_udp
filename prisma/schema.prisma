// NexgenSocial - Prisma schema
// Run `npx prisma migrate dev` locally, `npx prisma migrate deploy` on Render.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FriendStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PostType {
  TEXT
  VIDEO
  IMAGE
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum GroupRole {
  MEMBER
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  displayName   String
  bio           String?
  avatarUrl     String?
  coverUrl      String?
  tier          SubscriptionTier @default(FREE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posts             Post[]
  comments          Comment[]
  likes             Like[]

  sentFriendReqs     FriendRequest[] @relation("SentFriendReqs")
  receivedFriendReqs FriendRequest[] @relation("ReceivedFriendReqs")

  following     Follow[] @relation("Following")
  followers     Follow[] @relation("Followers")

  groupMemberships GroupMember[]
  groupsOwned       Group[] @relation("GroupOwner")

  ads           Ad[]
  marketListings MarketListing[]

  socialAccounts SocialAccount[]
  invitesSent    Invite[]

  feedWeights Json @default("{\"recency\":0.5,\"engagement\":0.3,\"diversity\":0.2}")

  circlesOwned  Circle[]
  circleMemberships CircleMember[]
  contextNotes  ContextNote[]
  noteVotes     NoteVote[]
  livestreams   Livestream[]

  // --- Extended profile (all optional: nothing here is required to use
  // the platform, and each field is only collected if the person fills it
  // in themselves) ---
  birthDate        DateTime?
  gender           String?
  relationshipStatus RelationshipStatus?
  occupation       String?
  education        String?
  // Free-text city/country the person types themselves -- distinct from
  // any device-derived location, which is opt-in and stored separately.
  city             String?
  country          String?
  // IANA timezone (e.g. "America/New_York") so the UI can show the
  // person's real local time rather than the viewer's.
  timezone         String?
  hasChildren      Boolean?

  interests        UserInterest[]
  visitedPlaces    VisitedPlace[]
  adEvents         AdEvent[]
  privacySettings  PrivacySettings?

  reels            Reel[]
  reelViews        ReelView[]
  reelLikes        ReelLike[]
  reelComments     ReelComment[]

  politicalPages     PoliticalPage[] @relation("PoliticalPageOwner")
  politicalFollowing PoliticalPageFollower[]

  newsrooms          Newsroom[] @relation("NewsroomOwner")
  newsroomFollowing  NewsroomFollower[]

  jobPostings        JobPosting[]     @relation("JobPoster")
  jobApplications    JobApplication[] @relation("JobApplicant")

  conversations      ConversationParticipant[]
  messagesSent       Message[]
  callsMade          Call[] @relation("CallCaller")
  callsReceived      Call[] @relation("CallCallee")

  meetingsHosted     Meeting[] @relation("MeetingHost")
  meetingSeats       MeetingParticipant[]
  meetingInvites     MeetingInvite[]
  meetingChat        MeetingChatMessage[]

  // Recorded at signup. Storing WHEN each document was accepted (and which
  // version) is the practical difference between "we have a policy" and
  // "we can show this user agreed to it" if it's ever questioned.
  acceptedTermsAt        DateTime?
  acceptedPrivacyAt      DateTime?
  acceptedPolicyVersion  String?
}

enum RelationshipStatus {
  SINGLE
  IN_RELATIONSHIP
  ENGAGED
  MARRIED
  DOMESTIC_PARTNERSHIP
  SEPARATED
  DIVORCED
  WIDOWED
  PREFER_NOT_TO_SAY
}

// A shared, finite tag list so ad targeting can match on stable IDs rather
// than fuzzy free text.
model Interest {
  id       String         @id @default(cuid())
  name     String         @unique
  category String?
  users    UserInterest[]
  adTargets AdTargetInterest[]
}

model UserInterest {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  interestId String
  createdAt  DateTime @default(now())

  @@unique([userId, interestId])
}

// Places the person explicitly chooses to save. This is deliberately NOT
// passive/background location tracking: each row is created by an
// intentional "I visited here" action, which is both far less invasive and
// far simpler to justify under GDPR/CCPA than continuous device tracking.
model VisitedPlace {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  address    String?
  latitude   Float
  longitude  Float
  // Provider place identifiers, when the place came from a maps search
  googlePlaceId String?
  appleMapsId   String?
  visitedAt  DateTime @default(now())
  note       String?
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Per-user consent flags. Defaults are deliberately OFF for anything
// beyond basic in-platform targeting, so consent is opt-in rather than
// opt-out -- which is what GDPR actually requires, and is much easier to
// build in from the start than retrofit later.
model PrivacySettings {
  id                   String  @id @default(cuid())
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String  @unique
  // Allow demographics/interests to inform which ads are shown in-app.
  allowInterestTargeting Boolean @default(false)
  // Allow recording which ads/posts were viewed & clicked, for relevance
  // and advertiser conversion reporting.
  allowBehavioralTracking Boolean @default(false)
  // Allow this account's data to contribute to ANONYMOUS, AGGREGATE
  // audience counts shown to advertisers (never individual profiles --
  // see the k-anonymity threshold in routes/adsTargeting.js).
  allowAggregateInsights  Boolean @default(false)
  // Show the person's saved places on their public profile.
  showVisitedPlaces       Boolean @default(false)
  updatedAt            DateTime @updatedAt
}

model FriendRequest {
  id          String       @id @default(cuid())
  sender      User         @relation("SentFriendReqs", fields: [senderId], references: [id])
  senderId    String
  receiver    User         @relation("ReceivedFriendReqs", fields: [receiverId], references: [id])
  receiverId  String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  @@unique([senderId, receiverId])
}

model Follow {
  id          String   @id @default(cuid())
  follower    User     @relation("Following", fields: [followerId], references: [id])
  followerId  String
  following   User     @relation("Followers", fields: [followingId], references: [id])
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

enum PostAudience {
  PUBLIC
  FRIENDS
  FOLLOWERS
  CIRCLE
}

enum PostCategory {
  GENERAL
  SPORTS
  CELEBRITY
  NEWS
}

model Post {
  id         String   @id @default(cuid())
  author     User     @relation(fields: [authorId], references: [id])
  authorId   String
  type       PostType @default(TEXT)
  body       String?
  mediaUrl   String?
  group      Group?   @relation(fields: [groupId], references: [id])
  groupId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  audience   PostAudience @default(PUBLIC)
  circle     Circle?      @relation(fields: [circleId], references: [id])
  circleId   String?
  category   PostCategory @default(GENERAL)

  isAiGenerated Boolean @default(false)
  aiTool        String?
  editedAt      DateTime?

  comments   Comment[]
  likes      Like[]
  revisions  PostRevision[]
  contextNotes ContextNote[]
  media      PostMedia[]
}

// Posts originally supported exactly one attachment via the mediaUrl/type
// fields above. Those are retained so existing posts still render, but new
// posts attach through here, which allows several photos and videos in one
// post -- the same pattern used by listings, articles and messages.
model PostMedia {
  id        String    @id @default(cuid())
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  url       String
  kind      MediaKind
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([postId])
}

// A snapshot of a post's body taken every time it's edited, so edits are
// never silent -- anyone can see exactly what changed and when.
model PostRevision {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  body      String?
  editedAt  DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime @default(now())
}

model Like {
  id       String @id @default(cuid())
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   String
  user     User   @relation(fields: [userId], references: [id])
  userId   String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  coverUrl    String?
  isPrivate   Boolean  @default(false)
  owner       User     @relation("GroupOwner", fields: [ownerId], references: [id])
  ownerId     String
  createdAt   DateTime @default(now())

  members     GroupMember[]
  posts       Post[]
  meetingInvites MeetingInvite[]
}

model GroupMember {
  id       String    @id @default(cuid())
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  String
  user     User      @relation(fields: [userId], references: [id])
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
}

// --- Premium surfaces (scaffolded: schema + CRUD exist, UI is a starting point) ---

enum AdCategory {
  BUSINESS
  POLITICAL
  GENERAL
}

enum AdPaymentStatus {
  PENDING_PAYMENT
  PAID
  REJECTED
  EXPIRED
}

model Ad {
  id         String     @id @default(cuid())
  owner      User       @relation(fields: [ownerId], references: [id])
  ownerId    String
  category   AdCategory @default(GENERAL)
  headline   String
  body       String
  // Legacy single image, kept so existing ads still render. New ads use
  // the media relation below, which supports photos and video.
  imageUrl   String?
  targetUrl  String?
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())

  // --- Budget & scheduling ---
  // An ad does not serve until paymentStatus is PAID and the current date
  // falls inside the window. Gating on payment is enforced in the serving
  // query, not just the UI, so an unpaid ad can't be shown by calling the
  // API directly.
  paymentStatus AdPaymentStatus @default(PENDING_PAYMENT)
  budgetCents   Int             @default(5000) // $50 base
  durationDays  Int             @default(7)
  startsAt      DateTime?
  endsAt        DateTime?
  // Reach tier the advertiser paid for -- caps how many people the ad is
  // shown to, so a larger budget buys a genuinely larger audience.
  reachCap      Int?
  // Reference the advertiser gives you after paying, so a manual check
  // against Stripe is possible without a webhook integration.
  paymentRef    String?
  paidAt        DateTime?
  // Stripe Checkout Session id. Stored so a webhook can find the ad it
  // belongs to, and so a session can't be replayed to pay for a second ad.
  stripeSessionId String? @unique
  // What Stripe actually charged, which may differ from budgetCents if
  // anything went wrong. The ad's reach is granted on THIS figure, never on
  // the requested budget -- otherwise a $50 payment could buy a $2000 ad.
  amountPaidCents Int?

  media      AdMedia[]

  // --- Targeting criteria (all optional; omitting one means "don't filter
  // on this dimension" rather than "match nobody") ---
  targetMinAge      Int?
  targetMaxAge      Int?
  targetGenders     String[] // empty array = any
  targetCities      String[] // empty array = any
  targetCountries   String[]
  targetRelationshipStatuses String[]
  targetInterests   AdTargetInterest[]

  events            AdEvent[]
}

model AdMedia {
  id        String    @id @default(cuid())
  ad        Ad        @relation(fields: [adId], references: [id], onDelete: Cascade)
  adId      String
  url       String
  kind      MediaKind
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([adId])
}

model AdTargetInterest {
  id         String   @id @default(cuid())
  ad         Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  adId       String
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  interestId String

  @@unique([adId, interestId])
}

enum AdEventType {
  IMPRESSION
  CLICK
  CONVERSION
}

// Behavioral + conversion tracking. Only written when the person's
// PrivacySettings.allowBehavioralTracking is true -- enforced in
// routes/adsTargeting.js, not just by convention.
model AdEvent {
  id        String      @id @default(cuid())
  ad        Ad          @relation(fields: [adId], references: [id], onDelete: Cascade)
  adId      String
  // Nullable so an event can be retained for advertiser counts even if the
  // user later deletes their account (the row is anonymized, not orphaned).
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  type      AdEventType
  // For CONVERSION events: optional value (e.g. order total in cents) so
  // advertisers can measure ROI, not just raw conversion counts.
  valueCents Int?
  createdAt DateTime    @default(now())

  @@index([adId, type])
  @@index([userId])
}

model MarketListing {
  id          String   @id @default(cuid())
  seller      User     @relation(fields: [sellerId], references: [id])
  sellerId    String
  title       String
  description String
  priceCents  Int
  // Kept for backward compatibility with listings created before media
  // uploads existed. New listings use the `media` relation below, which
  // supports multiple photos AND video -- most real listings (cars,
  // property, furniture) need several angles, not one image URL.
  imageUrl    String?
  condition   String?
  location    String?
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime @default(now())

  media       ListingMedia[]
}

enum ListingStatus {
  ACTIVE
  SOLD
  WITHDRAWN
}

enum MediaKind {
  PHOTO
  VIDEO
}

model ListingMedia {
  id         String        @id @default(cuid())
  listing    MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String
  url        String
  kind       MediaKind
  // Explicit ordering so the seller controls which photo is the cover
  // image, rather than it depending on upload timing.
  position   Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([listingId])
}

// --- Linked social accounts & invites ---

enum SocialProvider {
  FACEBOOK
  INSTAGRAM
  X
  LINKEDIN
  TIKTOK
  GOOGLE
}

// Represents one external account linked to a NexgenSocial user.
// providerUserId/accessToken are populated by a real OAuth flow in
// production (see backend/src/routes/social.js for the seam); for now
// connect() creates this record directly so the UI is fully functional.
model SocialAccount {
  id             String         @id @default(cuid())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  provider       SocialProvider
  providerUserId String?
  displayName    String?
  accessToken    String? // set by a real OAuth exchange; never expose to the frontend
  connectedAt    DateTime       @default(now())

  @@unique([userId, provider])
}

enum InviteStatus {
  SENT
  ACCEPTED
}

model Invite {
  id        String       @id @default(cuid())
  sender    User         @relation(fields: [senderId], references: [id])
  senderId  String
  token     String       @unique @default(cuid())
  channel   String // "email" | "sms" | "link"
  contact   String? // email address or phone number, if provided
  status    InviteStatus @default(SENT)
  createdAt DateTime     @default(now())
  acceptedById String?
}

// --- Custom audience circles (finer-grained than public/friends/followers) ---

model Circle {
  id        String   @id @default(cuid())
  name      String
  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   String
  createdAt DateTime @default(now())

  members   CircleMember[]
  posts     Post[]
}

model CircleMember {
  id       String @id @default(cuid())
  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  circleId String
  user     User   @relation(fields: [userId], references: [id])
  userId   String

  @@unique([circleId, userId])
}

// --- Crowd-sourced context notes (platform-wide, on any post) ---

model ContextNote {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime @default(now())

  votes     NoteVote[]
}

model NoteVote {
  id        String      @id @default(cuid())
  note      ContextNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId    String
  user      User        @relation(fields: [userId], references: [id])
  userId    String
  value     Int // 1 = helpful, -1 = not helpful
  createdAt DateTime    @default(now())

  @@unique([noteId, userId])
}

// --- Live streams: real-time video via WebRTC, signaled through this
// server's WebSocket endpoint (see backend/src/livestreamSignaling.js).
// Peer-to-peer mesh scales to a handful of concurrent viewers per host --
// see the README for what a real broadcast-scale setup needs.

enum LivestreamStatus {
  LIVE
  ENDED
}

model Livestream {
  id        String           @id @default(cuid())
  host      User             @relation(fields: [hostId], references: [id])
  hostId    String
  title     String
  status    LivestreamStatus @default(LIVE)
  startedAt DateTime         @default(now())
  endedAt   DateTime?

  // A broadcast can optionally be attributed to a newsroom, which is what
  // turns "someone went live" into "Channel X is broadcasting". Nullable
  // because personal streams stay exactly as they were.
  newsroom   Newsroom? @relation(fields: [newsroomId], references: [id], onDelete: SetNull)
  newsroomId String?

  @@index([newsroomId])
}

// --- Media Coverage: newsroom pages ---------------------------------------
//
// A newsroom is an editorial identity: an outlet, show, or independent
// journalist that publishes articles and broadcasts live. Kept separate
// from PoliticalPage on purpose -- a newsroom reporting ON a campaign is a
// fundamentally different thing from the campaign's own page, and blurring
// them is exactly the confusion that erodes trust in a feed.

model Newsroom {
  id          String   @id @default(cuid())
  owner       User     @relation("NewsroomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  name        String
  slug        String   @unique
  description String?
  // The organisation legally responsible for what's published here. Shown
  // publicly, for the same reason political pages carry it: readers should
  // always be able to see who stands behind a claim.
  organization String
  websiteUrl  String?
  avatarUrl   String?
  coverUrl    String?
  // Editorial beat, e.g. "Politics", "Local", "Tech".
  beat        String?
  region      String?
  // Set by a platform admin after checking the outlet is real. Unverified
  // newsrooms are labelled as such rather than hidden -- readers can see
  // the difference instead of being asked to assume.
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  articles    NewsArticle[]
  followers   NewsroomFollower[]
  livestreams Livestream[]
  media       NewsroomMedia[]

  @@index([beat])
}

// Photos and video that belong to the newsroom itself rather than to a
// single story -- studio shots, team photos, a channel trailer. Distinct
// from ArticleMedia, which is tied to one published piece.
model NewsroomMedia {
  id         String    @id @default(cuid())
  newsroom   Newsroom  @relation(fields: [newsroomId], references: [id], onDelete: Cascade)
  newsroomId String
  url        String
  kind       MediaKind
  caption    String?
  position   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([newsroomId])
}

model NewsroomFollower {
  id         String   @id @default(cuid())
  newsroom   Newsroom @relation(fields: [newsroomId], references: [id], onDelete: Cascade)
  newsroomId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime @default(now())

  @@unique([newsroomId, userId])
}

model NewsArticle {
  id         String   @id @default(cuid())
  newsroom   Newsroom @relation(fields: [newsroomId], references: [id], onDelete: Cascade)
  newsroomId String
  headline   String
  // Short summary shown in feeds and cards.
  standfirst String?
  body       String
  // Legacy single-image field, retained for existing articles.
  imageUrl   String?
  // Named byline, since the person publishing through the account is often
  // not the account owner (an editor posting a reporter's piece).
  byline     String?
  // Breaking stories surface differently in the newsroom feed.
  isBreaking Boolean  @default(false)
  publishedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Set whenever the body changes after publication, so corrections are
  // visible rather than silent -- same principle as post edit history.
  correctedAt DateTime?

  media      ArticleMedia[]

  @@index([newsroomId])
  @@index([publishedAt])
}

model ArticleMedia {
  id        String      @id @default(cuid())
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
  url       String
  kind      MediaKind
  // Optional caption/credit -- standard practice in news photography, and
  // often a licensing requirement for wire images.
  caption   String?
  position  Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([articleId])
}

// --- Reels: short-form vertical video, optimized for discovery ---------
//
// Kept as its own model rather than reusing Post, because the ranking
// signals are fundamentally different. A feed post ranks on who you follow;
// a reel ranks on completion rate and replays from people who DON'T follow
// you -- that's what makes it a top-of-funnel growth tool rather than
// another way to reach your existing audience.

model Reel {
  id          String   @id @default(cuid())
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  videoUrl    String
  thumbnailUrl String?
  caption     String?
  // Duration in seconds, recorded at publish time so ranking can compute
  // completion rate without probing the file on every request.
  durationSec Float?

  // Audio attribution. There is deliberately no bundled music catalog --
  // see the README: a "trending sounds" library requires actual licensing
  // deals with rights holders. This records what the creator supplied.
  soundName   String?
  soundArtist String?
  // True when the audio is the creator's own recording rather than an
  // uploaded track, so the UI can label it honestly.
  isOriginalAudio Boolean @default(true)

  // Editing metadata, retained so a reel can be re-edited later without
  // re-uploading, and so "remix this" style features have something to
  // work from.
  colorGrade  String?  // named preset, e.g. "warm", "noir"
  createdAt   DateTime @default(now())

  hashtags    ReelHashtag[]
  views       ReelView[]
  likes       ReelLike[]
  comments    ReelComment[]

  @@index([createdAt])
  @@index([authorId])
}

model Hashtag {
  id        String        @id @default(cuid())
  tag       String        @unique // stored lowercase, without the leading '#'
  createdAt DateTime      @default(now())
  reels     ReelHashtag[]
}

model ReelHashtag {
  id        String  @id @default(cuid())
  reel      Reel    @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reelId    String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  hashtagId String

  @@unique([reelId, hashtagId])
  @@index([hashtagId])
}

// The core discoverability signal. Watch time and completion matter far
// more than likes for short-form ranking: a reel someone watched twice all
// the way through is a stronger quality signal than a passive like.
model ReelView {
  id            String   @id @default(cuid())
  reel          Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reelId        String
  viewer        User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  viewerId      String?
  watchedSec    Float    @default(0)
  completed     Boolean  @default(false)
  replayCount   Int      @default(0)
  // Whether the viewer followed the author at view time -- lets ranking
  // measure reach to NEW audiences specifically, which is the whole point.
  viewerFollowedAuthor Boolean @default(false)
  createdAt     DateTime @default(now())

  @@index([reelId])
  @@unique([reelId, viewerId])
}

model ReelLike {
  id       String   @id @default(cuid())
  reel     Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reelId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  createdAt DateTime @default(now())

  @@unique([reelId, userId])
}

model ReelComment {
  id        String   @id @default(cuid())
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reelId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([reelId])
}

// --- Political Place ------------------------------------------------------
//
// Political content is treated as a distinct category rather than folded
// into general posts/ads, because the legal obligations genuinely differ.
// In the US the FEC requires "paid for by" disclaimers on political
// advertising; the EU's DSA and Political Advertising Regulation require
// disclosure plus a public, searchable archive. Meta and Google both run
// public political ad libraries for exactly this reason. The schema below
// makes those requirements structural rather than optional.

enum PoliticalPageType {
  CANDIDATE
  PARTY
  ISSUE
  CAMPAIGN
  ORGANIZATION
}

model PoliticalPage {
  id          String            @id @default(cuid())
  owner       User              @relation("PoliticalPageOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  type        PoliticalPageType
  name        String
  description String?
  // Who is actually behind this page. Required, and shown publicly --
  // anonymous political pages are the core thing disclosure rules exist to
  // prevent.
  organization String
  websiteUrl  String?
  // Jurisdiction/region the page is active in, so ad rules and archives
  // can be filtered per country or state.
  region      String?
  avatarUrl   String?
  coverUrl    String?
  // Set by a platform admin after verifying the organization is real. The
  // UI displays unverified pages differently rather than hiding the
  // distinction.
  verified    Boolean           @default(false)
  createdAt   DateTime          @default(now())

  followers   PoliticalPageFollower[]
  posts       PoliticalPost[]
  ads         PoliticalAd[]
  media       PoliticalPageMedia[]

  @@index([type])
}

model PoliticalPageMedia {
  id        String        @id @default(cuid())
  page      PoliticalPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  url       String
  kind      MediaKind
  caption   String?
  position  Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([pageId])
}

model PoliticalPageFollower {
  id        String        @id @default(cuid())
  page      PoliticalPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime      @default(now())

  @@unique([pageId, userId])
}

model PoliticalPost {
  id        String        @id @default(cuid())
  page      PoliticalPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  body      String
  // Legacy single-file field, kept so posts created before multi-upload
  // existed still render. New posts use the `media` relation.
  mediaUrl  String?
  createdAt DateTime      @default(now())

  media     PoliticalPostMedia[]

  @@index([pageId])
}

model PoliticalPostMedia {
  id        String        @id @default(cuid())
  post      PoliticalPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  url       String
  kind      MediaKind
  position  Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([postId])
}

// Political ads are a separate model from the commercial Ad, not a
// category flag on it. They carry mandatory disclosure fields, and every
// one of them lands in a permanently public archive (see
// routes/political.js) -- including after the campaign ends, which is
// specifically what transparency regulations require.
model PoliticalAd {
  id            String        @id @default(cuid())
  page          PoliticalPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId        String
  headline      String
  body          String
  // imageUrl is retained for existing ads. mediaUrl/mediaKind supersede it
  // and allow video creative, which is what most political advertising
  // actually uses.
  imageUrl      String?
  mediaUrl      String?
  mediaKind     MediaKind?
  targetUrl     String?

  // --- Mandatory disclosure ---
  // The legally required "Paid for by ___" line.
  paidForBy     String
  // Declared spend and reach, which archives are expected to surface.
  spendCents    Int           @default(0)
  region        String?

  active        Boolean       @default(true)
  startedAt     DateTime      @default(now())
  endedAt       DateTime?

  impressions   Int           @default(0)
  clicks        Int           @default(0)

  @@index([pageId])
  @@index([active])
}

// --- Jobs -----------------------------------------------------------------

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  VOLUNTEER
}

enum WorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

enum JobStatus {
  OPEN
  CLOSED
  FILLED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  INTERVIEWING
  OFFERED
  REJECTED
  WITHDRAWN
}

model JobPosting {
  id           String          @id @default(cuid())
  poster       User            @relation("JobPoster", fields: [posterId], references: [id], onDelete: Cascade)
  posterId     String
  companyName  String
  companyLogoUrl String?
  title        String
  description  String
  responsibilities String?
  requirements String?
  location     String?
  arrangement  WorkArrangement @default(ONSITE)
  employmentType EmploymentType @default(FULL_TIME)

  // Salary range is a first-class field rather than free text buried in the
  // description, because pay transparency is now legally required in a
  // growing number of places -- California, Colorado, New York, and
  // Washington all mandate a good-faith range in job postings, and the EU
  // Pay Transparency Directive extends similar duties. Structured fields
  // also make the range filterable, which free text never is.
  salaryMin    Int?
  salaryMax    Int?
  salaryCurrency String?       @default("USD")
  salaryPeriod String?         @default("YEAR") // YEAR | MONTH | HOUR

  applyUrl     String?  // external ATS link, if they'd rather receive applications elsewhere
  status       JobStatus @default(OPEN)
  createdAt    DateTime @default(now())
  expiresAt    DateTime?

  applications JobApplication[]

  @@index([status])
  @@index([createdAt])
}

model JobApplication {
  id          String            @id @default(cuid())
  job         JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  applicant   User              @relation("JobApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  applicantId String
  coverLetter String?
  resumeUrl   String?
  status      ApplicationStatus @default(SUBMITTED)
  // Free-text note the employer keeps on the application. Never shown to
  // the applicant -- surfacing private hiring notes would be both a nasty
  // surprise and, in some jurisdictions, a data-access complication.
  employerNote String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, applicantId])
  @@index([applicantId])
}

// --- Direct messaging & calls ---------------------------------------------

model Conversation {
  id           String   @id @default(cuid())
  // Direct (1:1) conversations are the only kind for now. Kept as a model
  // rather than a flat message table so group chat can be added later
  // without a migration that rewrites every message.
  isGroup      Boolean  @default(false)
  title        String?
  createdAt    DateTime @default(now())
  lastMessageAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
  calls        Call[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  // Used to compute unread counts without scanning every message.
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  body           String?
  createdAt      DateTime     @default(now())
  // Edits are visible rather than silent, consistent with how posts and
  // news articles behave elsewhere in the app.
  editedAt       DateTime?

  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id        String    @id @default(cuid())
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  url       String
  kind      MediaKind
  position  Int       @default(0)

  @@index([messageId])
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
}

enum CallKind {
  AUDIO
  VIDEO
}

// An in-app call between NexgenSocial users, carried over the existing
// WebRTC/mediasoup infrastructure. This is NOT a telephone call: dialling
// a real phone number requires a licensed carrier or a provider account
// (Twilio, Vonage, Telnyx) and per-minute billing. See the README.
model Call {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  caller         User         @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callerId       String
  callee         User         @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  calleeId       String
  kind           CallKind     @default(AUDIO)
  status         CallStatus   @default(RINGING)
  startedAt      DateTime     @default(now())
  answeredAt     DateTime?
  endedAt        DateTime?

  @@index([calleeId, status])
  @@index([conversationId])
}

// --- NexgenMeet: multi-party meetings -------------------------------------

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum MeetingRole {
  HOST
  COHOST
  PARTICIPANT
}

enum RecordingVisibility {
  PRIVATE
  PUBLIC
}

model Meeting {
  id          String        @id @default(cuid())
  host        User          @relation("MeetingHost", fields: [hostId], references: [id], onDelete: Cascade)
  hostId      String
  title       String
  description String?
  // Short human-shareable code, so a meeting can be joined by typing rather
  // than only by following a link.
  code        String        @unique
  status      MeetingStatus @default(SCHEDULED)
  scheduledFor DateTime?
  startedAt   DateTime?
  endedAt     DateTime?

  // --- Host controls ---
  // Participants wait for admission instead of entering directly. Defaults
  // on: an open room that anyone with the code can walk into is a real
  // problem once a link leaks.
  waitingRoomEnabled Boolean @default(true)
  muteOnEntry        Boolean @default(true)
  allowParticipantScreenShare Boolean @default(true)
  allowChat          Boolean @default(true)
  locked             Boolean @default(false)

  createdAt   DateTime      @default(now())

  participants MeetingParticipant[]
  invites      MeetingInvite[]
  recordings   MeetingRecording[]
  chat         MeetingChatMessage[]

  @@index([code])
  @@index([hostId])
}

model MeetingParticipant {
  id        String      @id @default(cuid())
  meeting   Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      MeetingRole @default(PARTICIPANT)
  // Set when the host admits them from the waiting room.
  admitted  Boolean     @default(false)
  mutedByHost Boolean   @default(false)
  removed   Boolean     @default(false)
  joinedAt  DateTime?
  leftAt    DateTime?
  createdAt DateTime    @default(now())

  @@unique([meetingId, userId])
  @@index([meetingId])
}

model MeetingInvite {
  id        String   @id @default(cuid())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId String
  // Either a specific user, or a whole group.
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String?
  createdAt DateTime @default(now())

  @@index([meetingId])
  @@index([userId])
}

model MeetingChatMessage {
  id        String   @id @default(cuid())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId  String
  body      String
  createdAt DateTime @default(now())

  @@index([meetingId, createdAt])
}

model MeetingRecording {
  id         String              @id @default(cuid())
  meeting    Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId  String
  url        String
  durationSec Float?
  sizeBytes  Int?
  // A recording is private until the host explicitly publishes it. Meeting
  // recordings can contain anything, so defaulting to public would be a
  // serious mistake.
  visibility RecordingVisibility @default(PRIVATE)
  // Set if the host publishes it as a post, so the two stay linked.
  postId     String?
  createdAt  DateTime            @default(now())

  @@index([meetingId])
}
